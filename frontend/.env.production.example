# Production environment template for the GAME frontend.
# Copy this to .env on/before the production build if it needs different
# values -- as-is this is the same CDN already used in local dev, which is
# fine to reuse unless you want a separate production asset bucket.
VITE_ASSET_CDN_BASE=https://cdn.jsdelivr.net/gh/KAVYA-hbt/moneyverse-cdn-assets@main
