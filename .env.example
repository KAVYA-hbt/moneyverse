# Copy this to .env (repo root) and fill in real values. Read
# automatically by docker-compose.yml -- these drive the game's local
# Postgres + pgAdmin containers. Never commit the filled-in .env.
POSTGRES_USER=moneyverse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moneyverse
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
