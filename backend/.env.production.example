# Production environment template for the GAME backend.
# Copy this to .env on the production server and fill in every
# REPLACE_WITH_* placeholder below. Never commit the filled-in version
# (real secrets) to git.

# Real production Postgres connection. Get a fresh, strong password from
# whoever provisions the database -- do NOT reuse the local dev password
# ("moneyverse") from docker-compose.yml/backend/.env here.
DATABASE_URL=postgresql+psycopg2://moneyverse:REPLACE_WITH_STRONG_PASSWORD@REPLACE_WITH_DB_HOST:5432/moneyverse

# The real deployed frontend URL (used for CORS), e.g.
# https://moneyverse.yourdomain.com -- must NOT be left as localhost.
FRONTEND_ORIGIN=REPLACE_WITH_PRODUCTION_FRONTEND_URL

# Real API keys, only needed if these features are actually used in production.
MESHY_API_KEY=REPLACE_WITH_REAL_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_REAL_KEY
LLM_MODEL=claude-sonnet-4-6
