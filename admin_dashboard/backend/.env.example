# Local dev default: SQLite file, no external services needed.
DATABASE_URL=sqlite+aiosqlite:///./finguru.db
# Production target: PostgreSQL, e.g.
# DATABASE_URL=postgresql+asyncpg://finguru:finguru@localhost:5432/finguru_admin
JWT_SECRET=change-me-in-prod-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

BACKEND_HOST=127.0.0.1
# The game's own backend is hardcoded to port 8000 on the frontend side
# (moneyverse/frontend/src/utils/apiBase.js) and can't be moved -- so this admin backend runs on
# 8001 by default to avoid clashing with it when both run locally at the same time. Must match
# frontend/.env's BACKEND_PORT (the Vite proxy target).
BACKEND_PORT=8001
# Must match frontend/.env's FRONTEND_PORT.
CORS_ORIGINS=http://localhost:5183

# "db" (default) or "mock". "mock" serves generated in-memory player profile data for
# previewing the Player Profiles screens without a seeded database (see app/services/mock_data.py).
# Scoped to /api/profiles only -- auth and /api/handoffs always use the database.
DATA_SOURCE=db

# Live sync directly from the game's own Postgres DB (see app/services/game_sync.py and
# app/game_db/): on startup, a background loop queries GAME_DATABASE_URL every
# PROFILE_SYNC_INTERVAL_SECONDS -- via a hand-maintained async port of the game backend's own
# app/profile_builder.py scoring logic -- and upserts real players/profiles/quest history into
# this app's DB, so Player Profiles reflects live gameplay automatically. Same
# host/user/password/db as the game backend's own DATABASE_URL (moneyverse/backend/.env), just
# the asyncpg driver instead of psycopg2 (this app's DB layer is async throughout). Set
# ENABLE_GAME_SYNC=false to turn it off (e.g. if the game's DB isn't reachable from here, or you
# only want the manual `python -m app.import_profiles` path). Ignored when DATA_SOURCE=mock.
GAME_DATABASE_URL=postgresql+asyncpg://moneyverse:moneyverse@localhost:5432/moneyverse
PROFILE_SYNC_INTERVAL_SECONDS=25
ENABLE_GAME_SYNC=true
