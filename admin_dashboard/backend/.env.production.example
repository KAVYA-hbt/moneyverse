# Production environment template for the ADMIN DASHBOARD backend.
# Copy this to .env on the production server and fill in every
# REPLACE_WITH_* placeholder below. Never commit the filled-in version
# (real secrets) to git.
#
# JWT_SECRET in particular: the local dev .env has this sitting at the
# literal placeholder value "change-me-in-prod-please". That must NEVER
# reach production as-is -- anyone who knows that string could forge
# valid admin login tokens. Generate a real one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Real production Postgres for the admin dashboard's own data (separate
# database from the game -- see GAME_DATABASE_URL below for that one).
DATABASE_URL=postgresql+asyncpg://finguru:REPLACE_WITH_STRONG_PASSWORD@REPLACE_WITH_DB_HOST:5432/finguru_admin

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

BACKEND_HOST=0.0.0.0
BACKEND_PORT=REPLACE_WITH_PRODUCTION_PORT

# The real deployed admin dashboard frontend URL -- must match
# admin_dashboard/frontend's production FRONTEND_PORT/URL.
CORS_ORIGINS=REPLACE_WITH_PRODUCTION_FRONTEND_URL

DATA_SOURCE=db

# Live sync from the GAME's own production Postgres -- must point at the
# SAME database as backend/.env.production.example's DATABASE_URL (same
# host, user, password, db name), just the asyncpg driver instead of
# psycopg2. If the game's DB credentials change, this has to change too,
# or Player Profiles sync will silently stop working.
GAME_DATABASE_URL=postgresql+asyncpg://moneyverse:REPLACE_WITH_STRONG_PASSWORD@REPLACE_WITH_DB_HOST:5432/moneyverse
PROFILE_SYNC_INTERVAL_SECONDS=25
ENABLE_GAME_SYNC=true

# If this backend can't open a direct DB connection to the game's database (common in a
# locked-down sandbox/internal network), set GAME_SYNC_SOURCE=json_file instead -- this backend
# and the game backend must then be deployed on the same host/filesystem. See
# admin_dashboard/backend/app/services/game_sync.py for how it works.
GAME_SYNC_SOURCE=db
GAME_EXPORT_JSON_PATH=../../shared_data/exported_profiles.json
GAME_SYNC_JSON_POLL_SECONDS=5
